{
  "name": "clear-safe-router",
  "version": "0.1.0",
  "type": "module",
  "description": "File-based React SPA router with compile-time type-safe navigation",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite-plugin/index.js",
      "types": "./dist/types/vite-plugin/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run router:generate && vite",
    "build": "npm run router:generate && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:playground": "npm run router:generate && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run router:generate && vitest run",
    "test:run": "npm test",
    "test:coverage": "npm run router:generate && vitest run --coverage",
    "test:e2e": "playwright test",
    "router:generate": "node scripts/generate-routes.mjs --routes playground/routes --out playground/routeTree.gen.ts",
    "generate": "npm run router:generate",
    "typecheck": "npm run router:generate && tsc -b --force && tsc --noEmit -p tests/types/tsconfig.json"
  },
  "keywords": [
    "react",
    "router",
    "routing",
    "file-based",
    "typescript",
    "type-safe"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mui/material": "^9.5.0",
    "@tabler/icons-react": "^3.51.0",
    "motion": "^14.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
