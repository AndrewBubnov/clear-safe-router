{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": true,
    // No declarationMap in the published package: the .map files are useless
    // without the sources (which stay out of the tarball) and ~doubled the
    // types payload. "Go to definition" resolves to the .d.ts instead.
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-build/tsbuildinfo"
  },
  "include": ["src/index.tsx", "src/core/index.ts", "src/types.ts", "src/vite-env.d.ts", "src/vite-plugin/index.ts"]
}
