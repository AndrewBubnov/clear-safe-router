{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./types/.tsbuildinfo"
  },
  "include": ["src/index.tsx", "src/types.ts", "src/runtime.ts", "src/route-api.tsx", "src/vite-plugin/index.ts"]
}
