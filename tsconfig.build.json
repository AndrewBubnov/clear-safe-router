{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-build/tsbuildinfo"
  },
  "include": ["src/index.tsx", "src/types.ts", "src/vite-env.d.ts", "src/vite-plugin/index.ts"]
}
