{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "node_modules/.cache/tsc-node"
  },
  "include": ["vite.config.ts", "scripts", "src/vite-plugin/**/*.ts"]
}
